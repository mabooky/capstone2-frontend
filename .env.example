# 서버 주소입니다. 설정하지 않으면 배포 서버를 사용합니다.
# 로컬 백엔드를 쓸 때는 아래 값을 .env.local에 적습니다.
VITE_API_BASE=https://capstone2-backend-production.up.railway.app

# Spotify 앱의 Client ID입니다. 설정하지 않으면 관리자 화면은 소리 없이 데모로 재생해요.
# 공개되어도 되는 값이며, Client Secret은 이 파일에 넣지 않습니다.
# 대시보드의 Redirect URI에 http://127.0.0.1:5173/auth/spotify/callback (배포 후에는 HTTPS 주소의 같은 경로)를 등록해야 해요.
VITE_SPOTIFY_CLIENT_ID=
